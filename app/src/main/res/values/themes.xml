<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ScreenRotator" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!--
        磁贴弹出的悬浮选择窗：一个全屏透明、自身带遮罩的 Activity。
        不是系统 Dialog，因为 Dialog 在锁屏 / 控制中心收起过程中的行为不可控；
        Activity 才能被 TileService.startActivityAndCollapse 正常拉起。
        深色 Material 作父主题是为了让状态栏图标在暗遮罩上保持浅色；
        面板内的所有颜色都由 @color 显式指定，因此亮/暗主题仍按 values-night 切换。
    -->
    <style name="Theme.ScreenRotator.Popup" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.ScreenRotator.Popup</item>
    </style>

    <style name="Animation.ScreenRotator.Popup" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/tile_menu_in</item>
        <item name="android:windowExitAnimation">@anim/tile_menu_out</item>
    </style>

    <!--
        主界面的设置面板：贴底弹出的 Dialog，窗口本身只有面板那么大。
        遮罩交给窗口的 dim（点面板外即关闭由 WindowManager 判定，不需要一整个全屏 View），
        背景透明 + 上下滑动的窗口动画，观感与磁贴的悬浮选择窗保持同一套。
    -->
    <style name="Theme.ScreenRotator.Sheet" parent="Theme.ScreenRotator">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowAnimationStyle">@style/Animation.ScreenRotator.Sheet</item>
    </style>

    <style name="Animation.ScreenRotator.Sheet" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>

    <!--
        设置面板里的三段选择器（外观 / 语言共用）。
        选中态由代码渲染（整块填主题色），这里只管尺寸与未选中时的文字颜色。
        maxLines=1 + ellipsize：英文标签（English / 简体中文）比中文长，宁可省略也不能把行撑高。
    -->
    <style name="Widget.ScreenRotator.Segment" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
